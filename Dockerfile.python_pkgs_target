# Debian 12
FROM debian:12 as python_debian12

ARG pkg_list

COPY --from=python_debian11 /root/ /root/

RUN apt-get update -y && apt-get install -y --no-install-recommends build-essential libpq-dev python3-pip python3-dev

ENV PATH="/opt/venv/bin:$PATH"

RUN pip3 install --upgrade-strategy only-if-needed --break-system-packages $pkg_list
RUN pip3 install --break-system-packages pipdeptree

RUN printf "Debian 12 - $(python3 --version) - PASSED\n$(echo $(pipdeptree --freeze -d 0 -p pexpect,psycopg2) | sed -r 's/ /, /g')\n\n" >> /root/py_list.txt

# RHEL 8
FROM rockylinux:8 as python_rl8

ARG pkg_list

COPY --from=python_debian12 /root/ /root/

RUN yum install -y python3-pip python3-devel python3-libs gcc gcc-c++ libpq-devel

RUN pip3 install --upgrade-strategy only-if-needed $pkg_list
RUN pip3 install pip-chill

RUN printf "RHEL 8 - $(python3 --version) - PASSED\n$(echo $(pip-chill --no-chill | grep -iE '^(pexpect|psycopg2).*') | sed -r 's/ /, /g')\n\n" >> /root/py_list.txt

# RHEL 9
FROM rockylinux:9 as python_rl9

ARG pkg_list

COPY --from=python_rl8 /root/ /root/

RUN yum install -y python3-pip python3-devel python3-libs gcc libpq-devel

RUN pip3 install --upgrade-strategy only-if-needed $pkg_list
RUN pip3 install pipdeptree

RUN printf "RHEL 9 - $(python3 --version) - PASSED\n$(echo $(pipdeptree --freeze -d 0 -p pexpect,psycopg2) | sed -r 's/ /, /g')\n\n" >> /root/py_list.txt

# Amazon Linux 2
FROM amazonlinux:2 as python_al2

ARG pkg_list

COPY --from=python_rl9 /root/ /root/

RUN yum install -y python3-pip python3-devel gcc postgresql-devel openssl

RUN pip3 install --upgrade-strategy only-if-needed $pkg_list && pip3 install --upgrade-strategy only-if-needed "requests<=2.32.3,urllib3<2.0.0"
RUN pip3 install pip-chill

RUN printf "Amazon Linux 2 - $(python3 --version) - PASSED\n$(echo $(pip-chill --no-chill | grep -iE '^(pexpect|psycopg2).*') | sed -r 's/ /, /g')\n\n" >> /root/py_list.txt

# Amazon Linux 2023
FROM amazonlinux:2023 as python_al2023

ARG pkg_list

COPY --from=python_al2 /root/ /root/

RUN yum install -y python3-pip python3-requests python3-devel python3-wheel python3-setuptools gcc libpq-devel

RUN pip3 install --upgrade-strategy only-if-needed $pkg_list
RUN pip3 install pipdeptree==2.16.1

RUN printf "Amazon Linux 2023 - $(python3 --version) - PASSED\n$(echo $(pipdeptree --freeze -d 0 -p pexpect,psycopg2) | sed -r 's/ /, /g')\n" >> /root/py_list.txt

CMD cat /root/py_list.txt
