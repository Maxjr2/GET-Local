ARG pkg_list="pexpect<=4.9.0 psycopg2<=3.2.1"

# Target oldest support version
FROM python:3.8-slim-bullseye as python_default

ARG pkg_list

RUN apt-get update -y && apt-get install -y --no-install-recommends build-essential libpq-dev

RUN pip3 install --upgrade-strategy only-if-needed $pkg_list
RUN pip3 install pipdeptree

RUN touch /root/py_list.txt && printf "Target - $(python3 --version)\n$(echo $(pipdeptree --freeze -d 0 -p pexpect,psycopg2) | sed -r 's/==/<=/g' | sed -r 's/ /, /g')\n\n" >> /root/py_list.txt

# Ubuntu 20.04
FROM ubuntu:20.04 as python_ubuntu20

ARG pkg_list

COPY --from=python_default /root/ /root/

RUN apt-get update -y && apt-get install -y --no-install-recommends build-essential libpq-dev python3-pip python3-dev

RUN pip3 install --upgrade-strategy only-if-needed $pkg_list
RUN pip3 install pipdeptree

RUN printf "Ubuntu 20.04 - $(python3 --version) - PASSED\n$(echo $(pipdeptree --freeze -d 0 -p pexpect,psycopg2) | sed -r 's/ /, /g')\n\n" >> /root/py_list.txt

# Ubuntu 22.04
FROM ubuntu:22.04 as python_ubuntu22

ARG pkg_list

COPY --from=python_ubuntu20 /root/ /root/

RUN apt-get update -y && apt-get install -y --no-install-recommends build-essential libpq-dev python3-pip python3-dev

RUN pip3 install --upgrade-strategy only-if-needed $pkg_list
RUN pip3 install pipdeptree

RUN printf "Ubuntu 22.04 - $(python3 --version) - PASSED\n$(echo $(pipdeptree --freeze -d 0 -p pexpect,psycopg2) | sed -r 's/ /, /g')\n\n" >> /root/py_list.txt

# Ubuntu 24.04
FROM ubuntu:24.04 as python_ubuntu24

ARG pkg_list

COPY --from=python_ubuntu22 /root/ /root/

RUN apt-get update -y && apt-get install -y --no-install-recommends build-essential libpq-dev python3-pip python3-dev

ENV PATH="/opt/venv/bin:$PATH"

RUN pip3 install --upgrade-strategy only-if-needed --break-system-packages $pkg_list
RUN pip3 install --break-system-packages pipdeptree

RUN printf "Ubuntu 24.04 - $(python3 --version) - PASSED\n$(echo $(pipdeptree --freeze -d 0 -p pexpect,psycopg2) | sed -r 's/ /, /g')\n\n" >> /root/py_list.txt

