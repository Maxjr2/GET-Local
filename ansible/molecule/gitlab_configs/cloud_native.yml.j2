global:
  kas:
    enabled: false
  minio:
    enabled: false
  appConfig:
    object_store:
      enabled: true
      connection:
        secret: gitlab-minio-secret
        key: key
    artifacts:
      enabled: true
      proxy_download: true
      bucket: gitlab
    uploads:
      enabled: true
      proxy_download: true
      bucket: gitlab
    backups:
      enabled: true
      proxy_download: true
      bucket: gitlab
    lfs:
      enabled: true
      proxy_download: true
      bucket: gitlab
  ingress:
    configureCertmanager: false
    class: traefik
  shell:
    port: 32022
  redis: {}
installCertmanager: false
nginx-ingress:
  enabled: false
gitlab:
  gitlab-shell:
    service:
      type: NodePort
      nodePort: 32022
  toolbox:
    backups:
      backend: s3
      config:
        secret: gitlab-minio-backup-secret
  gitaly:
    cgroups:
      enabled: false
prometheus:
  install: false
gitlab-runner:
  install: false
redis:
  install: true
