global:
  kas:
    enabled: false
  minio:
    enabled: false
  appConfig:
    object_store:
      enabled: true
      connection:
        secret: gitlab-buckets-secret
        key: key
    artifacts:
      enabled: true
      proxy_download: true
      bucket: gitlab
    uploads:
      enabled: true
      proxy_download: true
      bucket: gitlab
    backups:
      enabled: true
      proxy_download: true
      bucket: gitlab
    lfs:
      enabled: true
      proxy_download: true
      bucket: gitlab
    dependencyProxy:
      enabled: true
      proxy_download: true
      bucket: gitlab
  ingress:
    configureCertmanager: false
  shell:
    port: 32022
  registry:
    bucket: gitlab
installCertmanager: false
gitlab:
  gitlab-shell:
    service:
      type: NodePort
      nodePort: 32022
  toolbox:
    backups:
      backend: s3
      config:
        secret: gitlab-backup-bucket-secret
  gitaly:
    cgroups:
      enabled: false
prometheus:
  install: false
gitlab-runner:
  install: false
registry:
  storage:
    secret: gitlab-container-registry-object-storage-key
    key: config

{% if openbao_enable %}
openbao:
  config:
    audit:
      http:
        enabled: false
{% endif %}
