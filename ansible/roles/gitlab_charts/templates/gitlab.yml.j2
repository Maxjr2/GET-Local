gitlab:
  webservice:
    maxReplicas: "{{ webservice_max_replicas }}"
    minReplicas: "{{ webservice_min_replicas }}"
    maxUnavailable: "{{ webservice_max_unavailable }}"
    hpa:
      cpu:
        targetAverageValue: 1600m
    resources:
      limits:
        memory: "{{ gitlab_charts_webservice_limits_memory_gb }}G"
      requests:
        cpu: "{{ gitlab_charts_webservice_requests_cpu }}"
        memory: "{{ gitlab_charts_webservice_requests_memory_gb }}G"
    workerProcesses: "{{ gitlab_charts_webservice_worker_processes }}"
    ingress:
      proxyBodySize: 0  # Bigger file uploads, e.g. imports
      useGeoClass: false
{% if cloud_native_hybrid_geo_unified_url %}
    extraIngress:
      enabled: true
      hostname: "{{ (geo_primary_internal_url if cloud_native_hybrid_geo_role == 'primary' else geo_secondary_internal_url) | regex_replace('^https?:\/\/') }}"
      useGeoClass: {{ external_geo_ip != '' and (external_geo_ip != external_ip) }}
      tls:
        secretName: gitlab-webservice-ssl
{% endif %}
{% if gitlab_charts_node_selector_enable %}
    nodeSelector:
      workload: "{{ gitlab_charts_webservice_node_selector }}"
{% endif %}
{% if cloud_provider == 'aws' %}
    serviceAccount:
      annotations:
        eks.amazonaws.com/role-arn: "{{ aws_iam_arn_prefix }}:role/{{ prefix }}-eks-webservice-role"
{% if gitlab_operator %}
      name: "gitlab-webservice"
{% endif %}
{% endif %}
{% if cloud_provider == 'gcp' and gcp_gke_workload_identity_setup %}
    serviceAccount:
      annotations:
        iam.gke.io/gcp-service-account: "{{ gcp_service_account_prefix }}-gke-webservice@{{ gcp_project }}.iam.gserviceaccount.com"
{% if gitlab_operator %}
      name: "gitlab-webservice"
{% endif %}
{% endif %}
    metrics:
      enabled: true
      serviceMonitor:
        enabled: true
    workhorse:
      metrics:
        enabled: true
        serviceMonitor:
          enabled: true
{% set _workhorse_trusted_cidrs = geo_secondary_site_workhorse_trusted_cidrs if cloud_native_hybrid_geo_role == 'primary' else geo_primary_site_workhorse_trusted_cidrs %}
{% if cloud_native_hybrid_geo and _workhorse_trusted_cidrs | length > 0 %}
      extraArgs: "-propagateCorrelationID"
      trustedCIDRsForPropagation:
{% for cidr in _workhorse_trusted_cidrs %}
        - "{{ cidr }}"
{% endfor %}
      trustedCIDRsForXForwardedFor:
{% for cidr in _workhorse_trusted_cidrs %}
        - "{{ cidr }}"
{% endfor %}
{% endif %}
# Workaround for project deletion bug https://gitlab.com/gitlab-org/gitlab/-/issues/24110#note_729703160
{% if not container_registry_enable and gitlab_version != '' and gitlab_version is version('16.0', '<') %}
    registry:
      enabled: false
{% endif %}
{% if geo_disable_secondary_proxying %}
    extraEnv:
      GEO_SECONDARY_PROXY: "0"
{% endif %}
  sidekiq:
    maxReplicas: "{{ sidekiq_max_replicas }}"
    minReplicas: "{{ sidekiq_min_replicas }}"
    maxUnavailable: "{{ sidekiq_max_unavailable }}"
    hpa:
      cpu:
        targetAverageValue: 700m
    resources:
      limits:
        memory: "{{ gitlab_charts_sidekiq_limits_memory_gb }}G"
      requests:
        cpu: "{{ gitlab_charts_sidekiq_requests_cpu }}"
        memory: "{{ gitlab_charts_sidekiq_requests_memory_gb }}G"
{% if gitlab_charts_node_selector_enable %}
    nodeSelector:
      workload: "{{ gitlab_charts_sidekiq_node_selector }}"
{% endif %}
{% if cloud_provider == 'aws' %}
    serviceAccount:
      annotations:
        eks.amazonaws.com/role-arn: "{{ aws_iam_arn_prefix }}:role/{{ prefix }}-eks-sidekiq-role"
{% if gitlab_operator %}
      name: "gitlab-sidekiq"
{% endif %}
{% endif %}
{% if cloud_provider == 'gcp' and gcp_gke_workload_identity_setup %}
    serviceAccount:
      annotations:
        iam.gke.io/gcp-service-account: "{{ gcp_service_account_prefix }}-gke-sidekiq@{{ gcp_project }}.iam.gserviceaccount.com"
{% if gitlab_operator %}
      name: "gitlab-sidekiq"
{% endif %}
{% endif %}
    metrics:
      enabled: true
      podMonitor:
        enabled: true
# Workaround for project deletion bug https://gitlab.com/gitlab-org/gitlab/-/issues/24110#note_729703160
{% if not container_registry_enable and gitlab_version != '' and gitlab_version is version('16.0', '<') %}
    registry:
      enabled: false
{% endif %}
{% if cloud_provider != 'none' %}
  toolbox:
    backups:
      objectStorage:
        {{ lookup('template', 'object_storage/toolbox_backups_object_storage.' + cloud_provider + '.yml.j2') | indent(width=8) }}
{% if cloud_provider == 'aws' %}
    serviceAccount:
      annotations:
        eks.amazonaws.com/role-arn: "{{ aws_iam_arn_prefix }}:role/{{ prefix }}-eks-toolbox-role"
{% if gitlab_operator %}
      name: "gitlab-toolbox"
{% endif %}
{% endif %}
{% if cloud_provider == 'gcp' and gcp_gke_workload_identity_setup %}
    serviceAccount:
      annotations:
        iam.gke.io/gcp-service-account: "{{ gcp_service_account_prefix }}-gke-toolbox@{{ gcp_project }}.iam.gserviceaccount.com"
{% if gitlab_operator %}
      name: "gitlab-toolbox"
{% endif %}
{% endif %}
{% endif %}
# Workaround for project deletion bug https://gitlab.com/gitlab-org/gitlab/-/issues/24110#note_729703160
{% if not container_registry_enable and gitlab_version != '' and gitlab_version is version('16.0', '<') %}
    registry:
      enabled: false
{% endif %}
  migrations:
    psql:
      password:
        secret: gitlab-postgres-password
        key: password
      host: "{{ postgres_migrations_host }}"
      port: "{{ postgres_migrations_port }}"
{% if 'postgres' not in groups %}
      username: "{{ postgres_username }}"
      database: "{{ postgres_database_name }}"
{% endif %}
{% set use_envoy = gitlab_charts_gateway_api_setup and (gitlab_version == '' or gitlab_version is version('18.11', '>=')) %}
{% if pages_enable %}
  gitlab-pages:
{% if use_envoy %}
    ingress:
      enabled: false
{% else %}
    ingress:
      enabled: true
      tls:
{% if pages_ssl_enable and pages_ssl_cert != '' and pages_ssl_key != '' %}
        enabled: true
        secretName: gitlab-pages-ssl
{% else %}
        enabled: false
{% endif %}
{% endif %}
    metrics:
      enabled: true
      serviceMonitor:
        enabled: true
{% endif %}
{% if gitlab_shell_ssh_daemon == 'gitlab-sshd' %}
  gitlab-shell:
    sshDaemon: "{{ gitlab_shell_ssh_daemon }}"
    service:
      internalPort: {{ gitlab_shell_ssh_internal_port }}
{% endif %}
  gitlab-exporter:
    metrics:
      enabled: true
      serviceMonitor:
        enabled: true
  kas:
    metrics:
      enabled: true
      serviceMonitor:
        enabled: true
{% if gitlab_charts_gitaly_setup %}
## [Toolkit Beta] Gitaly on Kubernetes. Known limitations, see https://docs.gitlab.com/administration/gitaly/kubernetes/
  gitaly:
{% if gitlab_charts_node_selector_enable %}
    nodeSelector:
      workload: "{{ gitlab_charts_gitaly_node_selector }}"
{% endif %}
    resources:
      limits:
        cpu: "{{ gitlab_charts_gitaly_limits_cpu }}"
        memory: "{{ gitlab_charts_gitaly_limits_memory_gb }}G"
      requests:
        cpu: "{{ gitlab_charts_gitaly_requests_cpu }}"
        memory: "{{ gitlab_charts_gitaly_requests_memory_gb }}G"
    init:
      resources:
        requests:
          cpu: 1000m
          memory: 32Mi
        limits:
          cpu: 1000m
          memory: 32Mi
    persistence:
      storageClass: "{{ gitlab_charts_gitaly_storage_class }}"
      size: "{{ gitlab_charts_gitaly_storage_size }}"
    packObjectsCache:
      enabled: true
    cgroups: # https://docs.gitlab.com/ee/administration/gitaly/kubernetes.html#constrain-git-processes-resource-usage
      enabled: true
      memoryBytes: "{{ gitlab_charts_gitaly_cgroups_memory_bytes }}"
      cpuShares: '1024' # 100%
      repositories:
        count: 1
    antiAffinity: hard
    securityContext:
      fsGroupChangePolicy: OnRootMismatch
    gracefulRestartTimeout: 1
    metrics:
      enabled: true
      serviceMonitor:
        enabled: true
{% endif %}

global:
  # Deploy pods to Supporting node pool by default unless otherwise configured
{% if gitlab_charts_node_selector_enable %}
  nodeSelector:
    workload: "{{ gitlab_charts_supporting_node_selector }}"
{% endif %}
  serviceAccount:
    enabled: true
{% if use_envoy %}
  gatewayApi:
    enabled: true
    installEnvoy: true
    configureCertmanager: {{ external_url_ssl and external_ssl_source == 'letsencrypt' }}
{% endif %}
{% if cloud_provider != 'none' %}
  appConfig:
    object_store:
      enabled: true
      connection:
        secret: gitlab-object-storage-key
        key: key
{% if 'artifacts' in gitlab_object_storage_list %}
    artifacts:
      bucket: "{{ gitlab_object_storage_bucket_names['artifacts'] }}"
      proxy_download: false
{% endif %}
{% if 'lfs' in gitlab_object_storage_list %}
    lfs:
      bucket: "{{ gitlab_object_storage_bucket_names['lfs'] }}"
      proxy_download: false
{% endif %}
{% if 'packages' in gitlab_object_storage_list %}
    packages:
      bucket: "{{ gitlab_object_storage_bucket_names['packages'] }}"
      proxy_download: false
{% endif %}
{% if 'uploads' in gitlab_object_storage_list %}
    uploads:
      bucket: "{{ gitlab_object_storage_bucket_names['uploads'] }}"
      proxy_download: false
{% endif %}
{% if 'external_diffs' in gitlab_object_storage_list %}
    externalDiffs:
      enabled: true
      bucket: "{{ gitlab_object_storage_bucket_names['external_diffs'] }}"
      when: outdated
      proxy_download: false
{% endif %}
{% if 'dependency_proxy' in gitlab_object_storage_list %}
    dependencyProxy:
      enabled: true
      bucket: "{{ gitlab_object_storage_bucket_names['dependency_proxy'] }}"
      proxy_download: false
{% endif %}
{% if 'terraform_state' in gitlab_object_storage_list %}
    terraformState:
      enabled: true
      bucket: "{{ gitlab_object_storage_bucket_names['terraform_state'] }}"
      proxy_download: false
{% endif %}
{% if 'ci_secure_files' in gitlab_object_storage_list %}
    ciSecureFiles:
      enabled: true
      bucket: "{{ gitlab_object_storage_bucket_names['ci_secure_files'] }}"
      connection:
        secret: gitlab-object-storage-key
        key: key
{% endif %}
{% if 'backups' in gitlab_object_storage_list %}
    backups:
      bucket: "{{ gitlab_object_storage_bucket_names['backups'] }}"
{% endif %}
{% endif %}
  initialRootPassword:
    secret: gitlab-initial-root-password
    key: password
  railsSecrets:
    secret: gitlab-rails-secrets
  shell:
    port: {{ gitlab_shell_ssh_port }}
    authToken:
      secret: gitlab-shell-token
      key: password

  gitaly:
    authToken:
      secret: "{{ 'gitlab-praefect-external-token' if 'praefect' in groups else 'gitlab-gitaly-external-token' }}"
      key: password
# Linux Package - Gitaly Cluster
{% if 'gitaly' in groups and 'praefect' in groups %}
    external:
    - name: default
      hostname: "{{ internal_lb_host }}"
{% if praefect_ssl %}
      port: "{{ praefect_ssl_port }}"
      tlsEnabled: true
{% else %}
      port: 2305
{% endif %}
# Linux Package - Gitaly Sharded
{% elif 'gitaly' in groups %}
    external:
    - name: default
      hostname: "{{ gitaly_primary_int_addr }}"
{% if gitaly_ssl %}
      port: "{{ gitaly_ssl_port }}"
      tlsEnabled: true
{% else %}
      port: 8075
{% endif %}
    - name: storage1
      hostname: "{{ gitaly_primary_int_addr }}"
{% if gitaly_ssl %}
      port: "{{ gitaly_ssl_port }}"
      tlsEnabled: true
{% else %}
      port: 8075
{% endif %}
{% for gitaly_secondary_ip in gitaly_secondary_int_addrs %}
    - name: "storage{{loop.index + 1}}"
      hostname: "{{ gitaly_secondary_ip }}"
{% if gitaly_ssl %}
      port: "{{ gitaly_ssl_port }}"
      tlsEnabled: true
{% else %}
      port: 8075
{% endif %}
{% endfor %}
{% endif %}
## [Toolkit Beta] Gitaly on Kubernetes. Known limitations, see https://docs.gitlab.com/administration/gitaly/kubernetes/
{% if gitlab_charts_gitaly_setup %}
    internal:
      names:
{% for gitaly_chart_storage_name in gitlab_charts_gitaly_storage_names %}
        - "{{ gitaly_chart_storage_name }}"
{% endfor %}
{% else %}
    enabled: false # Gitaly runs outside of cluster
{% endif %}
  hosts:
{% if cloud_provider != 'aws' and not use_envoy %}
    externalIP: "{{ external_ip }}"
{% endif %}
{% if cloud_native_hybrid_geo_unified_url and not use_envoy %}
    externalGeoIP: "{{ external_geo_ip }}"
{% endif %}
    domain: "{{ external_host }}"
    https: {{ external_url_ssl | lower }}
    gitlab:
      name: "{{ external_host }}"
    registry:
      name: "{{ container_registry_external_host }}"
  ingress:
{% if use_envoy %}
    enabled: false
{% elif external_url_ssl and external_ssl_source == 'letsencrypt' %}
    configureCertmanager: true
{% elif external_url_ssl and external_ssl_source == 'user' %}
    configureCertmanager: false
    tls:
      secretName: gitlab-webservice-ssl
{% else %}
    configureCertmanager: false
    tls:
      enabled: false
{% endif %}
{% if ('praefect' in groups and praefect_ssl) or ('gitaly' in groups and gitaly_ssl) %}
  certificates:
    customCAs:
{% if 'praefect' in groups and praefect_ssl %}
      - secret: praefect-ca
{% elif 'gitaly' in groups and gitaly_ssl %}
      - secret: gitaly-ca
{% endif %}
{% endif %}
  minio:
    enabled: false
{% if openbao_enable %}
  openbao:
    enabled: true
    host: "{{ openbao_host }}"
    https: {{ openbao_ssl_enable | lower }}
{% endif %}
{% if pages_enable %}
  pages:
    enabled: true
    host: "{{ pages_host }}"
{% if pages_ssl_enable %}
    https: true
{% else %}
    https: false
{% endif %}
    objectStore:
      enabled: true
      bucket: "{{ gitlab_object_storage_bucket_names['pages'] }}"
{% endif %}
  psql:
    password:
      secret: gitlab-postgres-password
      key: password
{% if postgres_external %}
    host: "{{ postgres_host }}"
    port: "{{ postgres_port }}"
    username: "{{ postgres_username }}"
    database: "{{ postgres_database_name }}"
{% if postgres_load_balancing_hosts | length > 0 %}
    load_balancing:
      hosts:
{% for postgres_load_balancing_host in postgres_load_balancing_hosts %}
        - "{{ postgres_load_balancing_host }}"
{% endfor %}
{% endif %}
{% elif 'postgres' in groups %}
    host: "{{ internal_lb_host if 'haproxy_internal' in groups else postgres_host }}"
    port: "{{ 6432 if 'haproxy_internal' in groups else postgres_port }}"
{% if groups['postgres'] | length > 1 %}
    load_balancing:
      hosts:
{% for postgres_int_addr in postgres_int_addrs %}
        - "{{ postgres_int_addr }}"
{% endfor %}
{% endif %}
{% endif %}
# Redis
  redis:
{% if redis_external %}
## Redis Non Omnibus (PaaS \ User Provided)
### Combined Queues
    host: "{{ redis_host }}"
    port: "{{ redis_port }}"
    "{{ 'password' if ((gitlab_version != '') and (gitlab_version is version('16.0', '<'))) else 'auth' }}":
      secret: gitlab-redis-password
      key: password
    scheme: "{{ 'rediss' if redis_external_ssl else 'redis' }}"
{% elif redis_cache_external and redis_persistent_external %}
### Separate Queues
#### Default
    host: "{{ redis_persistent_host }}"
    port: "{{ redis_persistent_port }}"
    "{{ 'password' if ((gitlab_version != '') and (gitlab_version is version('16.0', '<'))) else 'auth' }}":
      secret: gitlab-redis-persistent-password
      key: password
    scheme: "{{ 'rediss' if redis_persistent_external_ssl else 'redis' }}"
#### Cache
    cache:
      host: "{{ redis_cache_host }}"
      port: "{{ redis_cache_port }}"
      password:
        secret: gitlab-redis-cache-password
        key: password
      scheme: "{{ 'rediss' if redis_cache_external_ssl else 'redis' }}"
{% elif 'redis' in groups %}
## Redis Omnibus - Separate Node(s)
### Single Node - Combined Queues
{% if groups['redis'] | length == 1 %}
    host: '{{ redis_host }}'
    port: '{{ redis_port }}'
    "{{ 'password' if ((gitlab_version != '') and (gitlab_version is version('16.0', '<'))) else 'auth' }}":
      secret: gitlab-redis-password
      key: password
{% elif groups['redis'] | length > 1 %}
#### Multi Node - Combined Queues
    host: gitlab-redis
    "{{ 'password' if ((gitlab_version != '') and (gitlab_version is version('16.0', '<'))) else 'auth' }}":
      secret: gitlab-redis-password
      key: password
    sentinels:
{% for ip in redis_int_addrs %}
      - host: '{{ ip }}'
        port: '{{ redis_sentinel_port }}'
{% endfor %}
{% endif %}
{% elif 'redis_cache' in groups and 'redis_persistent' in groups %}
### Multi Node - Separate Queues
#### Default
    host: gitlab-redis-persistent
    "{{ 'password' if ((gitlab_version != '') and (gitlab_version is version('16.0', '<'))) else 'auth' }}":
      secret: gitlab-redis-persistent-password
      key: password
    sentinels:
{% for ip in redis_persistent_int_addrs %}
      - host: '{{ ip }}'
{% endfor %}
#### Cache
    cache:
      host: gitlab-redis-cache
      password:
        secret: gitlab-redis-cache-password
        key: password
      sentinels:
{% for ip in redis_cache_int_addrs %}
      - host: '{{ ip }}'
{% endfor %}
{% endif %}
  registry:
{% if container_registry_enable %}
    enabled: true
    # global.registry.bucket is used by GitLab backups
    bucket: "{{ gitlab_object_storage_bucket_names['registry'] }}"
# Needed for Geo on Primary and Secondary sites for container registry replication
{% if (geo_container_registry_notification_secret != '') %}
    notificationSecret:
      secret: gitlab-registry-notification
      key: secret_token
{% endif %}
{% else %}
    enabled: false
{% endif %}
{% if cloud_native_hybrid_geo %}
  geo:
    nodeName: "{{ geo_primary_site_name if cloud_native_hybrid_geo_role == 'primary' else geo_secondary_site_name }}"
    enabled: true
    role: "{{ cloud_native_hybrid_geo_role }}"
    psql:
      host: "{{ geo_tracking_postgres_host }}"
      port: "{{ geo_tracking_postgres_port }}"
      password:
        secret: gitlab-geo-tracking-postgres-password
        key: password
{% if container_registry_enable and geo_primary_registry_url != '' %}
    registry:
      replication:
        enabled: true
{% if cloud_native_hybrid_geo_role == 'secondary' %}
        primaryApiUrl: "{{ geo_primary_registry_url }}"
{% endif %}
{% if cloud_native_hybrid_geo_unified_url and use_envoy %}
    gatewayApi:
      addionalHostname: "{{ (geo_primary_internal_url if cloud_native_hybrid_geo_role == 'primary' else geo_secondary_internal_url) | regex_replace('^https?:\/\/') }}"
{% endif %}
{% endif %}
{% endif %}

nginx-ingress-geo:
  enabled: {{ ((not use_envoy) and cloud_native_hybrid_geo_unified_url) | lower }}

nginx-ingress:
  enabled: {{ (not use_envoy) | lower }}
{% if not use_envoy %}
  controller:
    kind: DaemonSet
{% if gitlab_charts_node_selector_enable %}
    nodeSelector:
      workload: "{{ gitlab_charts_webservice_node_selector }}"
{% endif %}
    scope:
      enabled: false
    metrics:
      enabled: true
      serviceMonitor:
        enabled: true
{% if aws_allocation_ids != "" %}
    service:
      annotations:
        service.beta.kubernetes.io/aws-load-balancer-type: nlb
        service.beta.kubernetes.io/aws-load-balancer-eip-allocations: "{{ aws_allocation_ids | replace(' ', '') }}"
        service.beta.kubernetes.io/aws-load-balancer-cross-zone-load-balancing-enabled: "true"
        service.beta.kubernetes.io/aws-load-balancer-target-node-labels: workload=webservice
{% endif %}
{% if cloud_native_hybrid_geo_role == 'primary' %}
    config:
      use-forwarded-headers: true
{% endif %}
{% endif %}

{% set install_certmanager = external_url_ssl and external_ssl_source == 'letsencrypt' %}
{% if not install_certmanager and gitlab_version != '' and gitlab_version is version('18.3', '<') %}
certmanager:
  install: false
{% elif not install_certmanager %}
installCertmanager: false
{% endif %}

{% if install_certmanager and use_envoy %}
certmanager:
  config:
    enableGatewayAPI: true
{% endif %}

{% if external_url_ssl and external_ssl_source == 'letsencrypt' %}
certmanager-issuer:
  email: "{{ external_ssl_letsencrypt_issuer_email }}"
{% endif %}

{% if openbao_enable %}
openbao:
  install: true
{% if use_envoy %}
  ingress:
    enabled: false
{% endif %}
{% if openbao_unseal_awskms_enable %}
  serviceAccount:
    annotations:
      eks.amazonaws.com/role-arn: "{{ openbao_unseal_awskms_role_arn }}"
{% endif %}
  ingress:
    enabled: true
    hostname: "{{ openbao_host }}"
    configureCertmanager: {{ (openbao_ssl_enable | lower) and openbao_ssl_cert == '' }}
    tls:
{% if openbao_ssl_enable %}
      enabled: true
{% if openbao_ssl_cert != '' and openbao_ssl_key != '' %}
      secretName: gitlab-openbao-tls
{% endif %}
{% else %}
      enabled: false
{% endif %}
  config:
    storage:
      postgresql:
        connection:
          host: "{{ openbao_database_host }}"
          port: {{ openbao_database_port }}
          database: "{{ openbao_database_name }}"
          username: "{{ openbao_database_username }}"
          password:
            secret: gitlab-openbao-db-password
            key: password
{% if openbao_unseal_awskms_enable %}
    unseal:
      static:
        enabled: false
      awskms:
        enabled: true
        kmsKeyId: "{{ openbao_unseal_awskms_key_id }}"
        region: "{{ openbao_unseal_awskms_region }}"
{% elif openbao_unseal_key != '' %}
    unseal:
      static:
        currentKeyId: "{{ openbao_unseal_key_current_id }}"
{% endif %}
{% if openbao_unseal_key != '' and not openbao_unseal_awskms_enable %}
  staticUnsealSecret:
    generate: false
{% endif %}
  podMonitor:
    enable: true
  resources:
    limits:
      cpu: "{{ gitlab_charts_openbao_limits_cpu }}"
      memory: "{{ gitlab_charts_openbao_limits_memory }}"
    requests:
      cpu: "{{ gitlab_charts_openbao_requests_cpu }}"
      memory: "{{ gitlab_charts_openbao_requests_memory }}"
  autoscaling:
    minReplicas: {{ gitlab_charts_openbao_min_replicas }}
    maxReplicas: {{ gitlab_charts_openbao_max_replicas }}
{% if gitlab_charts_node_selector_enable %}
  nodeSelector:
    workload: "{{ gitlab_charts_supporting_node_selector }}"
{% endif %}
{% endif %}

# Run outside of cluster
redis:
  install: false
registry:
{% if (gitlab_version == '' or gitlab_version is version('18.3', '>=')) and (container_registry_database_configure and container_registry_enable) %}
  database:
    enabled: {{ container_registry_database_enabled }}
    host: {{ container_registry_database_host }}
    port: {{ container_registry_database_port }}
    name: {{ container_registry_database_name }}
    user: {{ container_registry_database_username }}
    password:
      secret: gitlab-container-registry-db-password
      key: password
    migrations:
      enabled: true
    sslmode: "{{ container_registry_database_ssl_mode }}"
{% endif %}
{% if container_registry_enable %}
  storage:
    secret: gitlab-container-registry-object-storage-key
    key: config
{% if cloud_provider == 'aws' %}
  serviceAccount:
    annotations:
      eks.amazonaws.com/role-arn: "{{ aws_iam_arn_prefix }}:role/{{ prefix }}-eks-registry-role"
{% if gitlab_operator %}
    name: "gitlab-registry"
{% endif %}
{% endif %}
{% if cloud_provider == 'gcp' and gcp_gke_workload_identity_setup %}
  serviceAccount:
    annotations:
      iam.gke.io/gcp-service-account: "{{ gcp_service_account_prefix }}-gke-registry@{{ gcp_project }}.iam.gserviceaccount.com"
{% if gitlab_operator %}
    name: "gitlab-registry"
{% endif %}
{% endif %}
  metrics:
    enabled: true
    serviceMonitor:
      enabled: true
{% else %}
  enabled: false
{% endif %}
postgresql:
  install: false
prometheus:
  install: false
# https://docs.gitlab.com/ee/ci/runners/#configuring-runners-in-gitlab
gitlab-runner:
  install: false

{% if use_envoy %}
gatewayApiResources:
  gateway:
{% if external_url_ssl and external_ssl_source == 'letsencrypt' %}
    protocol: "HTTPS"
{% elif external_url_ssl and external_ssl_source == 'user' %}
    protocol: "HTTPS"
{% else %}
    protocol: "HTTP"
{% endif %}
    listeners:
      gitlab-web:
{% if external_url_ssl %}
        protocol: "HTTPS"
        certificateRefs:
          - name: gitlab-webservice-ssl
{% else %}
        protocol: "HTTP"
{% endif %}
{% if cloud_native_hybrid_geo_unified_url %}
      gitlab-web-geo:
{% if external_url_ssl %}
        protocol: "HTTPS"
        certificateRefs:
          - name: gitlab-webservice-ssl
{% else %}
        protocol: "HTTP"
{% endif %}
{% endif %}
{% if container_registry_enable %}
      registry-web:
{% if external_url_ssl %}
        protocol: "HTTPS"
        certificateRefs:
          - name: gitlab-webservice-ssl
{% else %}
        protocol: "HTTP"
{% endif %}
{% endif %}
{% if pages_enable %}
      pages-web:
{% if pages_ssl_enable and pages_ssl_cert != '' and pages_ssl_key != '' %}
        protocol: "HTTPS"
        certificateRefs:
          - name: gitlab-pages-ssl
{% else %}
        protocol: "HTTP"
{% endif %}

{% endif %}
{% if openbao_enable %}
      openbao-web:
{% if openbao_ssl_enable %}
        protocol: "HTTPS"
        certificateRefs:
          - name: gitlab-openbao-tls
{% else %}
        protocol: "HTTP"
{% endif %}
{% endif %}
{% if aws_allocation_ids != "" %}
    infrastructure:
      annotations:
        service.beta.kubernetes.io/aws-load-balancer-type: nlb
        service.beta.kubernetes.io/aws-load-balancer-eip-allocations: "{{ aws_allocation_ids | replace(' ', '') }}"
        service.beta.kubernetes.io/aws-load-balancer-cross-zone-load-balancing-enabled: "true"
        service.beta.kubernetes.io/aws-load-balancer-target-node-labels: workload=webservice
{% elif gitlab_charts_gateway_api_gcp_ip_resource_names != "" %}
    infrastructure:
      annotations:
        networking.gke.io/load-balancer-type: External
        networking.gke.io/load-balancer-ip-addresses: "{{ gitlab_charts_gateway_api_gcp_ip_resource_names | replace(' ', '') }}"
        cloud.google.com/l4-rbs: enabled
{% endif %}
  envoy:
{% if gitlab_charts_node_selector_enable %}
    proxySpec:
      provider:
        kubernetes:
          envoyDaemonSet:
            pod:
              nodeSelector:
                workload: "{{ gitlab_charts_webservice_node_selector }}"
{% endif %}
    metrics:
      envoyGateway:
        serviceMonitor:
          enabled: true
      envoyProxy:
        podMonitor:
          enabled: true
{% endif %}
