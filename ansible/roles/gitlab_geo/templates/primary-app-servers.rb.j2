{% if not geo_primary_is_multi_node %}
geo_primary_role['enable'] = true
{% endif %}
gitlab_rails['geo_node_name'] = "{{ geo_primary_site_name }}"

{% if container_registry_enable and geo_container_registry_notification_secret != '' %}
registry['notifications'] = [
  {
    'name' => 'geo_event',
    'url' => '{{ external_url_sanitised }}/api/v4/container_registry_event/events',
    'headers' => {
      'Authorization' => ['{{ geo_container_registry_notification_secret }}']
    }
  }
]
{% endif %}

{% if geo_container_registry_notification_secret != '' %}
registry['notification_secret'] = "{{ geo_container_registry_notification_secret }}"
{% endif %}
