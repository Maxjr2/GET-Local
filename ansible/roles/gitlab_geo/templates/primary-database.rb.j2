postgresql['sql_replication_password'] = "{{ geo_sql_replication_password_md5 }}"
{% if geo_primary_postgres_is_ha %}
patroni['replication_slots'] = {
{% for replication_slot in geo_primary_replication_slots %}
    '{{ replication_slot }}' => { 'type' => 'physical' },
{% endfor %}
}

{% if geo_secondary_postgres_is_ha %}
# Configure Primary and Secondary Patroni access (via load balancer) for replication calls
# https://gitlab.com/gitlab-org/omnibus-gitlab/-/work_items/6594
{# Deprecated: postgres_trust_auth_cidr_blocks. #}
postgresql['trust_auth_cidr_addresses'] = {{ ['127.0.0.1/32'] + (geo_primary_site_postgres_int_ips | map('regex_replace', '$', '/32')) + [internal_lb_host + '/32']  + (postgres_trust_auth_cidr_blocks | default([])) }}
{% endif %}

patroni['postgresql']['max_replication_slots'] = {{ ((geo_primary_postgres_count | int) + (geo_secondary_site_count | int)) * 2 }}
patroni['postgresql']['max_wal_senders'] = {{ ((geo_primary_postgres_count | int) + (geo_secondary_site_count | int)) * 2 }}

patroni['replication_password'] = '{{ geo_sql_replication_password }}'

{% if patroni_password is defined %}
patroni['username'] = 'patroni-api'
patroni['password'] = '{{ patroni_password }}'
{% endif %}
{% else %}

{% if geo_primary_is_multi_node %}
geo_primary_role['enable'] = true
{% endif %}

gitlab_rails['db_password'] = "{{ postgres_password }}"

postgresql['sql_user_password'] = "{{ (postgres_password + 'gitlab') | md5 }}"

{% if 'gitlab_rails' in group_names %}
# Configure co-located PostgreSQL single node to accept replication calls
postgresql['listen_address'] = '0.0.0.0'
postgresql['md5_auth_cidr_addresses'] = {{ postgres_md5_auth_cidr_blocks }}
{% endif %}

{% if geo_secondary_postgres_is_ha %}
# Configure Secondary Patroni access for replication calls
# https://gitlab.com/gitlab-org/omnibus-gitlab/-/work_items/6594
{# Deprecated: postgres_trust_auth_cidr_blocks. #}
postgresql['trust_auth_cidr_addresses'] = {{ ['127.0.0.1/32'] + (geo_secondary_site_postgres_int_ips | map('regex_replace', '$', '/32')) + (postgres_trust_auth_cidr_blocks | default([])) }}
{% endif %}

postgresql['max_replication_slots'] = {{ geo_max_replication_slots }}
{% endif %}
