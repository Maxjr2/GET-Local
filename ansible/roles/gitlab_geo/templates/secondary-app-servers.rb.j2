{% if geo_secondary_is_multi_node %}
gitlab_rails['geo_node_name'] = "{{ geo_secondary_site_name }}"
gitlab_rails['auto_migrate'] = false

{% if 'gitlab_rails' in group_names %}
geo_logcursor['enable'] = true
{% endif %}

geo_secondary['enable'] = true
geo_secondary['db_host'] = '{{ geo_tracking_postgres_host }}'
geo_secondary['db_password'] = '{{ geo_tracking_postgres_password }}'
geo_secondary['db_port'] = '{{ geo_tracking_postgres_port }}'
geo_secondary['auto_migrate'] = false
{% endif %}

{% if container_registry_enable and geo_container_registry_notification_secret != '' %}
gitlab_rails['geo_registry_replication_enabled'] = true
gitlab_rails['geo_registry_replication_primary_api_url'] = '{{ geo_primary_registry_url }}'
{% endif %}

{% if geo_primary_site_workhorse_trusted_cidrs | length > 0 %}
gitlab_workhorse['propagate_correlation_id'] = true
gitlab_workhorse['trusted_cidrs_for_propagation'] = {{ geo_primary_site_workhorse_trusted_cidrs | to_json }}
gitlab_workhorse['trusted_cidrs_for_x_forwarded_for'] = {{ geo_primary_site_workhorse_trusted_cidrs | to_json }}
{% endif %}
