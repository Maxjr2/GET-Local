roles ['application_role']

external_url '{{ external_url_sanitised }}'

puma['listen'] = '0.0.0.0'

{% if gitlab_root_password is defined and gitlab_root_password != '' %}
gitlab_rails['initial_root_password'] = "{{ gitlab_root_password }}"
{% endif %}

gitlab_rails['gitlab_shell_ssh_port'] = "{{ gitlab_shell_ssh_port }}"
{% if gitlab_shell_ssh_daemon == 'gitlab-sshd' %}
gitlab_sshd['enable'] = true
gitlab_sshd['listen_address'] ="[::]:{{ gitlab_shell_ssh_internal_port }}"
{% endif %}

# Ensure UIDs and GIDs match between servers for NFS
{% if gitlab_user_uid != '' and gitlab_user_gid != '' -%}
user['uid'] = {{ gitlab_user_uid }}
user['gid'] = {{ gitlab_user_gid }}
{% endif -%}
{% if web_server_uid != '' and web_server_gid != '' -%}
web_server['uid'] = {{ web_server_uid }}
web_server['gid'] = {{ web_server_gid }}
{% endif -%}
{% if container_registry_enable and registry_uid is defined and registry_gid is defined -%}
registry['uid'] = {{ registry_uid }}
registry['gid'] = {{ registry_gid }}
{% endif -%}

# NGINX Config
nginx['enable'] = true
nginx['status']['options'] = {
  "server_tokens" => "off",
  "access_log" => "off",
  "deny" => "all",
{% if 'monitor' in groups %}
  "allow" => "{{ monitor_int_ip }}"
{% endif -%}
}

### Read X-Forwarded-For Header of HAProxy
# other real_ip config options
nginx['real_ip_header'] = 'X-Forwarded-For'
nginx['real_ip_recursive'] = 'on'
# Each address is added to NGINX config as 'set_real_ip_from <address>;'
nginx['real_ip_trusted_addresses'] = [
  '127.0.0.0/8',
{% if 'haproxy_external' in groups %}
  '{{ haproxy_external_int_ip }}',
{% endif %}
{% if 'haproxy_internal' in groups %}
  '{{ haproxy_internal_int_ip }}',
{% endif %}
{% for cidr_block in gitlab_rails_nginx_real_ip_trusted_cidr_blocks %}
  "{{ cidr_block }}",
{% endfor %}
]

# NGINX Port / SSL config
{% if gitlab_rails_nginx_external_ssl_letsencrypt %}
## External NGINX SSL - Single Node (Let's Encrypt)
letsencrypt['enable'] = true
letsencrypt['contact_emails'] = {{ [external_ssl_letsencrypt_issuer_email] }}

{% elif gitlab_rails_nginx_external_ssl_user %}
## External NGINX SSL - Single Node (User Provided)
nginx['ssl_certificate'] = "/etc/gitlab/ssl/{{ external_host }}.crt"
nginx['ssl_certificate_key'] = "/etc/gitlab/ssl/{{ external_host }}.key"

letsencrypt['enable'] = false

{% elif gitlab_rails_nginx_ssl %}
## Internal NGINX SSL (User Provided)
nginx['ssl_certificate'] = "/etc/gitlab/ssl/gitlab_rails_nginx.pem"
nginx['ssl_certificate_key'] = "/etc/gitlab/ssl/gitlab_rails_nginx.pem.key"

{% if not external_url_ssl %}
# Configure NGINX to listen on HTTPS internally if external SSL is not configured
nginx['listen_https'] = true
nginx['listen_port'] = 443
{% endif %}

letsencrypt['enable'] = false

{% else %}
## External Load Balancer SSL Termination / Non SSL
nginx['listen_port'] = 80
nginx['listen_https'] = false

letsencrypt['enable'] = false
{% endif %}

# Container Registry
{% if container_registry_enable %}
registry['enable'] = true
registry_external_url "{{ container_registry_external_url }}"

registry['debug_addr'] = "0.0.0.0:5001" # https://docs.gitlab.com/administration/monitoring/prometheus/registry_exporter/

{% if (gitlab_version == '' or gitlab_version is version('18.3', '>=')) and container_registry_database_configure %}
registry['database'] = {
  'enabled' => {{ container_registry_database_enabled | lower }},
{% if container_registry_database_external %}
  'host' => "{{ container_registry_database_host }}",
  'port' => {{ container_registry_database_port }},
  'user' => "{{ container_registry_database_username }}",
  'password' => "{{ container_registry_database_password }}",
  'dbname' => "{{ container_registry_database_name }}",
  'sslmode' => '{{ container_registry_database_ssl_mode }}'
{% endif %}
}
{% endif %}

# Registry NGINX SSL Config
{% if gitlab_rails_nginx_external_ssl_user %}
## External NGINX SSL - Single Node (User Provided)
registry_nginx['ssl_certificate'] = "/etc/gitlab/ssl/{{ external_host }}.crt"
registry_nginx['ssl_certificate_key'] = "/etc/gitlab/ssl/{{ external_host }}.key"

{% elif gitlab_rails_nginx_ssl %}
## Internal NGINX SSL (User Provided)
registry_nginx['ssl_certificate'] = "/etc/gitlab/ssl/gitlab_rails_nginx.pem"
registry_nginx['ssl_certificate_key'] = "/etc/gitlab/ssl/gitlab_rails_nginx.pem.key"

{% elif not gitlab_rails_nginx_external_ssl_letsencrypt %}
## External Load Balancer SSL Termination
registry_nginx['listen_port'] = 80
registry_nginx['listen_https'] = false
{% endif %}

{% else %}
registry['enable'] = false
{% endif %}

# Storage Config
## Object Storage - consolidated object storage configuration
## Note: cloud-provider object storage connection templates have been removed (Nutanix/on-prem
## has no built-in provider template). Configure object storage via Custom Config instead
## (see gitlab_rails_custom_config_file).

{% if 'gitlab_nfs' in groups and gitlab_object_storage_type == 'nfs' %}

## NFS - Objects
gitlab_rails['uploads_directory'] = '{{ gitlab_nfs_path }}/uploads'
gitlab_rails['shared_path'] = '{{ gitlab_nfs_path }}/shared'
gitlab_ci['builds_directory'] = '{{ gitlab_nfs_path }}/builds'
{% endif %}

# Pages
{% if pages_enable %}
gitlab_pages['enable'] = true
pages_external_url "{{ pages_external_url }}"

# Pages NGINX SSL Config
{% if gitlab_rails_pages_nginx_external_ssl %}
## External NGINX SSL - Single Node (User Provided)
pages_nginx['ssl_certificate'] = "/etc/gitlab/ssl/{{ pages_host }}.crt"
pages_nginx['ssl_certificate_key'] = "/etc/gitlab/ssl/{{ pages_host }}.key"

{% else %}
## External Load Balancer SSL Termination
pages_nginx['listen_port'] = 80
pages_nginx['listen_https'] = false
{% endif %}

{% if gitlab_object_storage_type == 'object_storage' %}
gitlab_rails['pages_local_store_enabled'] = false
{% endif %}
{% endif %}

{% if 'consul' in groups %}
# Consul Agent (Monitoring Auto Discovery)
consul['enable'] = true
consul['configuration'] = {
  bind_addr: "{{ ansible_facts['default_ipv4']['address'] }}",
  retry_join: %w({{ (consul_int_addrs | join(' ')) }})
}
consul['monitoring_service_discovery'] = true
{% endif %}

node_exporter['listen_address'] = '0.0.0.0:9100'
gitlab_workhorse['prometheus_listen_addr'] = '0.0.0.0:9229'
gitlab_rails['monitoring_whitelist'] = [
  '127.0.0.0/8',
{% for cidr_block in gitlab_rails_monitoring_cidr_blocks %}
  "{{ cidr_block }}",
{% endfor %}
]

# Components Config
# Redis
{% if redis_external %}
## Redis Non Omnibus (PaaS \ User Provided)
### Combined Queues
gitlab_rails['redis_host'] = '{{ redis_host }}'
gitlab_rails['redis_port'] = '{{ redis_port }}'
gitlab_rails['redis_password'] = '{{ redis_password }}'
gitlab_rails['redis_ssl'] = {{ redis_external_ssl | lower }}
gitlab_rails['redis_enable_client'] = {{ redis_external_enable_client | lower }}

{% elif redis_cache_external and redis_persistent_external %}
### Separate Queues
#### Default
gitlab_rails['redis_host'] = '{{ redis_persistent_host }}'
gitlab_rails['redis_port'] = '{{ redis_persistent_port }}'
gitlab_rails['redis_password'] = '{{ redis_persistent_password }}'
gitlab_rails['redis_ssl'] = {{ redis_persistent_external_ssl | lower }}

#### Cache
gitlab_rails['redis_cache_instance'] = '{{ "rediss" if redis_cache_external_ssl else "redis" }}://:{{ redis_cache_password}}@{{ redis_cache_host }}:{{ redis_cache_port }}'

{% elif 'redis' in groups %}
## Redis Omnibus - Separate Node(s)
### Single Node - Combined Queues
{% if groups['redis'] | length == 1 %}
gitlab_rails['redis_host'] = '{{ redis_host }}'
gitlab_rails['redis_port'] = '{{ redis_port }}'
gitlab_rails['redis_password'] = '{{ redis_password }}'

{% elif groups['redis'] | length > 1 %}
### Multi Node - Combined Queues
redis['master_name'] = 'gitlab-redis'
redis['master_password'] = '{{ redis_password }}'

gitlab_rails['redis_sentinels'] = [
{% for ip in redis_int_addrs %}
  {host: '{{ ip }}', port: {{ redis_sentinel_port }}},
{% endfor %}
]
{% endif %}

{% elif 'redis_cache' in groups and 'redis_persistent' in groups %}
### Multi Node - Separate Queues
#### Default
redis['master_name'] = 'gitlab-redis-persistent'
redis['master_password'] = '{{ redis_persistent_password }}'

gitlab_rails['redis_sentinels'] = [
{% for ip in redis_persistent_int_addrs %}
  {host: '{{ ip }}', port: {{ redis_sentinel_port }}},
{% endfor %}
]

#### Cache
gitlab_rails['redis_cache_instance'] = 'redis://:{{ redis_cache_password }}@gitlab-redis-cache'
gitlab_rails['redis_cache_sentinels'] = [
{% for ip in redis_cache_int_addrs %}
  {host: '{{ ip }}', port: {{ redis_sentinel_port }}},
{% endfor %}
]
{% else %}
## Redis Omnibus - Local
redis['enable'] = true
redis_exporter['listen_address'] = '0.0.0.0:9121'
{% endif %}

{% if 'sidekiq' in groups %}
## Sidekiq - Separate Node(s)
sidekiq['enable'] = false
{% else %}
## Sidekiq - Local
sidekiq['enable'] = true
sidekiq['listen_address'] = '0.0.0.0'

{% if 'gitaly' in groups %}
### Sidekiq - Scale up workers dynamically to 1/4 of CPUS unless single node
sidekiq['queue_groups'] = [
{% for cpu in range([(ansible_facts['processor_vcpus'] / 4) | int, 1] | max) %}
  "*",
{% endfor %}
]
{% endif %}
{% endif %}

# Postgres
{% if postgres_external %}
## Postgres Non Omnibus (PaaS \ User Provided)

{% if db_migrate is defined and db_migrate == true %}
gitlab_rails['db_host'] = '{{ postgres_migrations_host }}'
gitlab_rails['db_port'] = '{{ postgres_migrations_port }}'
gitlab_rails['auto_migrate'] = {{ (('gitlab_rails_primary' in group_names) and (geo_secondary_site_group_name not in groups)) | lower }}
{% else %}
gitlab_rails['db_host'] = '{{ postgres_host }}'
gitlab_rails['db_port'] = '{{ postgres_port }}'
gitlab_rails['auto_migrate'] = false
{% endif %}
gitlab_rails['db_username'] = '{{ postgres_username }}'
gitlab_rails['db_password'] = '{{ postgres_password }}'
gitlab_rails['db_database'] = '{{ postgres_database_name }}'

{% if postgres_load_balancing_hosts | length > 0 %}
gitlab_rails['db_load_balancing'] = { 'hosts' => {{ postgres_load_balancing_hosts }} }
{% endif %}

{% elif 'postgres' in groups %}
## Postgres Omnibus - Separate Node(s)
postgresql['enable'] = false

{% if 'pgbouncer' not in groups or (db_migrate is defined and db_migrate == true) %}
gitlab_rails['db_host'] = '{{ postgres_migrations_host }}'
gitlab_rails['db_port'] = '{{ postgres_migrations_port }}'
gitlab_rails['auto_migrate'] = {{ (('gitlab_rails_primary' in group_names) and (geo_secondary_site_group_name not in groups)) | lower }}
{% else %}
gitlab_rails['db_host'] = "{{ internal_lb_host }}"
gitlab_rails['db_port'] = 6432
gitlab_rails['auto_migrate'] = false
{% endif %}
gitlab_rails['db_password'] = '{{ postgres_password }}'

{% if groups['postgres'] | length > 1 %}
gitlab_rails['db_load_balancing'] = { 'hosts' => {{ postgres_int_addrs }} }
{% endif %}

{% else %}
## Postgres Omnibus - Local

postgresql['enable'] = true

{# Deprecated: postgres_trust_auth_cidr_blocks. #}
postgresql['trust_auth_cidr_addresses'] = {{ ['127.0.0.1/32'] + (postgres_trust_auth_cidr_blocks | default([])) }}

postgres_exporter['listen_address'] = '0.0.0.0:9187'
{% endif %}

{% if postgres_version != '' %}
postgresql['version'] = {{ postgres_version }}
{% endif %}

{% if 'monitor' in groups %}
## Monitor - Separate Node(s)
prometheus['enable'] = false
{% endif %}

{%- if geo_disable_secondary_proxying %}
gitlab_workhorse['env'] = {
  "GEO_SECONDARY_PROXY" => "0",
}
{% endif %}

{% if 'praefect' in groups %}
## Gitaly Cluster - Separate Node(s)
gitaly['enable'] = false

{% set storage_config %}
{
  "default" => {
    "gitaly_address" => "{{ 'tls' if praefect_ssl else 'tcp' }}://{{ internal_lb_host }}:{{ praefect_ssl_port if gitaly_ssl else '2305' }}",
    "gitaly_token" => '{{ praefect_external_token }}'
  }
}{% endset %}

{% if gitlab_version == '' or gitlab_version is version('17.8', '>=') %}
gitlab_rails['repositories_storages'] = {{ storage_config }}
{% else %}
git_data_dirs({{ storage_config }})
{% endif %}

{% elif 'gitaly' in groups %}
## Gitaly - Separate Node(s)
gitaly['enable'] = false
gitlab_rails['gitaly_token'] = '{{ gitaly_token }}'

{% set storage_config %}
{
  'default' => { 'gitaly_address' => "{{ 'tls' if gitaly_ssl else 'tcp' }}://{{ gitaly_primary_int_addr }}:{{ gitaly_ssl_port if gitaly_ssl else '8075' }}" },
  'storage1' => { 'gitaly_address' => "{{ 'tls' if gitaly_ssl else 'tcp' }}://{{ gitaly_primary_int_addr }}:{{ gitaly_ssl_port if gitaly_ssl else '8075' }}" },
{% for gitaly_secondary_ip in gitaly_secondary_int_addrs %}
  "storage{{loop.index + 1}}" => { 'gitaly_address' => "{{ 'tls' if gitaly_ssl else 'tcp' }}://{{ gitaly_secondary_ip }}:{{ gitaly_ssl_port if gitaly_ssl else '8075' }}" },
{% endfor %}
}{% endset %}

{% if gitlab_version == '' or gitlab_version is version('17.8', '>=') %}
gitlab_rails['repositories_storages'] = {{ storage_config }}
{% else %}
git_data_dirs({{ storage_config }})
{% endif %}

{% else %}
## Gitaly - Local
gitaly['enable'] = true

gitaly['configuration'] = {
  prometheus_listen_addr: '0.0.0.0:9236',
}

{% endif %}

geo_confs = Dir.glob(File.join("/etc/gitlab/", "gitlab.geo.*.rb"))
geo_confs.each { |conf|
  from_file conf
}

custom_confs = Dir.glob(File.join("/etc/gitlab/", "gitlab.{gitlab_rails,common}.*.rb"))
custom_confs.each { |conf|
  from_file conf
}
