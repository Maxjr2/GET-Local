frontend http-in
    bind *:80
{% if external_url_ssl and external_ssl_source != '' %}
    bind *:443 ssl crt /usr/local/etc/haproxy/ssl/ strict-sni

    http-request set-header X-Forwarded-Proto https if { ssl_fc }
    http-request set-header X-Forwarded-Ssl on if { ssl_fc }

{% if external_ssl_source == 'letsencrypt' %}
    acl letsencrypt path_beg /.well-known/acme-challenge/
    use_backend letsencrypt if letsencrypt
{% endif %}
{% endif %}

{% if container_registry_enable %}
    acl gitlab-registry hdr(host) -i {{ container_registry_external_host }}
    use_backend gitlab-registry if gitlab-registry
{% endif %}

    default_backend gitlab-rails

frontend gitlab-ssh-in
    bind *:{{ gitlab_shell_ssh_port }}
    mode tcp
    option tcplog
    option clitcpka

    default_backend gitlab-rails-ssh

backend gitlab-rails
    option httpchk GET /-/readiness
    option forwardfor
{% if external_url_ssl and external_ssl_source != '' %}
    redirect scheme https if !{ ssl_fc }
{% endif %}

{% for ip in gitlab_rails_int_addrs %}
{% if gitlab_rails_nginx_ssl %}
    server gitlab-rails{{loop.index}} {{ ip }}:443 check inter 3s fall 1 {{ 'ssl verify required ca-file /usr/local/etc/haproxy/trusted-certs/gitlab_rails_nginx_ca.pem' if gitlab_rails_nginx_ssl_ca != '' else '' }}
{% else %}
    server gitlab-rails{{loop.index}} {{ ip }}:80 check inter 3s fall 1
{% endif %}
{% endfor %}

backend gitlab-rails-ssh
    mode tcp
    option tcp-check
    option srvtcpka

{% for ip in gitlab_rails_int_addrs %}
    server gitlab-rails{{loop.index}} {{ ip }}:{{ gitlab_shell_ssh_internal_port }} track gitlab-rails/gitlab-rails{{loop.index}}
{% endfor %}

{% if container_registry_enable %}
backend gitlab-registry
    option forwardfor
{% if external_url_ssl and external_ssl_source != '' %}
    redirect scheme https if !{ ssl_fc }
{% endif %}

{% for ip in gitlab_rails_int_addrs %}
{% if gitlab_rails_nginx_ssl %}
    server gitlab-rails{{loop.index}} {{ ip }}:443 check inter 3s fall 1 {{ 'ssl verify required ca-file /usr/local/etc/haproxy/trusted-certs/gitlab_rails_nginx_ca.pem' if gitlab_rails_nginx_ssl_ca != '' else '' }}
{% else %}
    server gitlab-rails{{loop.index}} {{ ip }}:80 check inter 3s fall 1
{% endif %}
{% endfor %}
{% endif %}

{% if external_url_ssl and external_ssl_source == 'letsencrypt' %}
backend letsencrypt
    server acme-sh host.docker.internal:88
{% endif %}
